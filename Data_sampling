//                                    // Dry season composites: image collections to deal twith SLC-off era 
                                      // get images of dry season from two consecutive years 
                                      // takes two least cloudy images 
                                      // creates a median composite of these 2 images 
//_________________________________________________________________________________________________________________________________

function buildDryComposite(year, cloudThreshold) {
  // Get the four dry‐season windows around defined year 
  var col = getCollection(year, collection1)
    .map(function(img) { return img.clip(Taita_AOI); })
    .map(getCloudFraction)
    .filter(ee.Filter.lt('cloud_fraction', cloudThreshold))
    .sort('cloud_fraction', true)
    .map(getClouds2)
    // .map(getNDVI)            
    .map(indices_LS7); // call the indicies function 

  // Turn into a list and grab the two best images (cloudfraction- vise)
  var sortedList = col.toList(2);
  var img1 = ee.Image(sortedList.get(0));
  var img2 = ee.Image(sortedList.get(1));

  // create a median composite 
  var composite = ee.ImageCollection([img1, img2]).median();

  // get the metadata from the images 
  var timeStart = img1.get('system:time_start');
  var spacecraftID= img1.get('SPACECRAFT_ID')
  var lsProductID1=img1.get('L1_LANDSAT_PRODUCT_ID')
  var lsProductID2=img2.get('L1_LANDSAT_PRODUCT_ID')
  var imageType= 'composite'
  var year1=ee.String(img1.get('DATE_ACQUIRED'));  
  var year2= ee.String(img2.get('DATE_ACQUIRED')); 
  
  // add metadata to the composite 
  composite = composite
    .set('image_type', imageType)
    .set('system:time_start', timeStart)
    .set('year',year1.slice(0, 4)) // attach yaar of the images 
    .set('year2',year1.slice(0, 4))
    .set('SPACECRAFT_ID',spacecraftID)
    .set('L1_LANDSAT_PRODUCT_ID_1',lsProductID1)
    .set('L1_LANDSAT_PRODUCT_ID_2',lsProductID2);
    
  //label 
  var label = year + '-' + (year + 1);

  
  print('Composite for ' + label, composite);

  // Add the composite to the map
  Map.addLayer(
    composite,
    vizParamsNDVI,
    'NDVI ' + label,
    false
  );
  Map.addLayer(
    composite,
    vizParams,
    'RGB '  + label,
    false
  );

  return composite;
}

