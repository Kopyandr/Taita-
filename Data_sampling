// _____________________________________________________Landsat 7 -5 
function indices_LS7(image) {
  var ndvi = image.normalizedDifference(['SR_B4', 'SR_B3']).rename('NDVI');

  var evi = image.expression(
    '2.5 * ((b4 - b3) / (b4 + 6 * b3 - 7.5 * b1 + 1))',
    {
      b4: image.select('SR_B4'),
      b3: image.select('SR_B3'),
      b1: image.select('SR_B1')
    }
  ).rename('EVI');

  var tcg = image.expression(
    '-0.2848 * blue - 0.2435 * green - 0.5436 * red + 0.7243 * nir + 0.0840 * swir1 - 0.1800 * swir2',
    {
      blue: image.select('SR_B1'),
      green: image.select('SR_B2'),
      red: image.select('SR_B3'),
      nir: image.select('SR_B4'),
      swir1: image.select('SR_B5'),
      swir2: image.select('SR_B7')
    }
  ).rename('TCG');

  var tcw = image.expression(
    '0.1509 * blue + 0.1973 * green + 0.3279 * red + 0.3406 * nir - 0.7112 * swir1 - 0.4572 * swir2',
    {
      blue: image.select('SR_B1'),
      green: image.select('SR_B2'),
      red: image.select('SR_B3'),
      nir: image.select('SR_B4'),
      swir1: image.select('SR_B5'),
      swir2: image.select('SR_B7')
    }
  ).rename('TCW');

  return image.addBands([ndvi, evi, tcg, tcw]);
}

// __________________________________________________________Landsat 8
function indices_LS8(image) {
  var ndvi = image.normalizedDifference(['SR_B5', 'SR_B4']).rename('NDVI');

  var evi = image.expression(
      '2.5 * ((nir - red) / (nir + 6*red - 7.5*blue + 1))',
      {
        nir:  image.select('SR_B5'),
        red:  image.select('SR_B4'),
        blue: image.select('SR_B2')
      }
  ).rename('EVI');
// TCG  and TCW formula  Baig et al. (2014)  https://doi.org/10.1080/2150704X.2014.915434  for LS8
  var tcg = image.expression(
      '-0.2941*blue - 0.2430*green - 0.5424*red + 0.7276*nir + 0.0713*swir1 - 0.1608*swir2',
      {
        blue: image.select('SR_B2'),
        green: image.select('SR_B3'),
        red:   image.select('SR_B4'),
        nir:   image.select('SR_B5'),
        swir1: image.select('SR_B6'),
        swir2: image.select('SR_B7')
      }
  ).rename('TCG');

  var tcw = image.expression(
      '0.1511*blue + 0.1973*green + 0.3283*red + 0.3407*nir - 0.7117*swir1 - 0.4559*swir2',
      {
        blue: image.select('SR_B2'),
        green:image.select('SR_B3'),
        red:  image.select('SR_B4'),
        nir:  image.select('SR_B5'),
        swir1:image.select('SR_B6'),
        swir2:image.select('SR_B7')
      }
  ).rename('TCW');

  return image.addBands([ndvi, evi, tcg, tcw]);
}

// ______________________________________________________________Landsat 2 MSS
function indices_LS2(image) {
  var ndvi = image.normalizedDifference(['30','20']).rename('NDVI');
  var evi2 = image.expression(
      '2.5 * (nir - red) / (nir + 2.4*red + 1)',
      {
        nir: image.select('30'),
        red: image.select('20')
      }
  ).rename('EVI2');

  return image.addBands([ndvi, evi2]);
}

// Indicias on GLS 1975 surface reflectance data data 
function indices_LS2_sr(image) {
  // NDVI = (NIR − RED) / (NIR + RED)
  var ndvi = image
    .normalizedDifference(['SR_B3', 'SR_B2'])
    .rename('NDVI');
  
  // EVI2 = 2.5 * (NIR − RED) / (NIR + 2.4 * RED + 1)
  var evi2 = image.expression(
    '2.5 * (nir - red) / (nir + 2.4 * red + 1)', {
      nir: image.select('SR_B3'),
      red: image.select('SR_B2')
    }
  ).rename('EVI2');

  return image.addBands([ndvi, evi2]);
}

