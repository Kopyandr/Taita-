  Export.table.toDrive({
    collection:     samples,
    description:    'samples_' + product + '_' + year,
    folder:         'training data GEE_4',
    fileNamePrefix: 'samples_' + product + '_' + year,
    fileFormat:     'CSV'
  });
}


