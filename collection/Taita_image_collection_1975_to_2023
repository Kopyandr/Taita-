// scale function for LS 5 and 7 images
function applyScaleFactors(image) {
  // Scale the optical bands: selects any band starting with 'SR_B'
  var opticalBands = image.select('SR_B.').multiply(0.0000275).add(-0.2);
  // Scale the thermal band ('ST_B')
  var thermalBand = image.select('ST_B.*').multiply(0.00341802).add(149.0);
  // Overwrite the original bands with the scaled versions
  return image.addBands(opticalBands, null, true)
              .addBands(thermalBand, null, true);
}

//returns a collection of dry seasons from 2 consecutive years 
function getCollection (year,collection) {  
  var year1 = year-1;
  var year2 = year ;
  var year3 = year+1;
  
  var start1=ee.Date.fromYMD(year1,DrySeason1[0],DrySeason1[1]);//
  var finish1= ee.Date.fromYMD(year2,DrySeason1[2],DrySeason1[3]);
  var start2=ee.Date.fromYMD(year2,DrySeason2[0],DrySeason2[1]);//
  var finish2=ee.Date.fromYMD(year2,DrySeason2[2],DrySeason2[3]);
  var start3=ee.Date.fromYMD(year2,DrySeason1[0],DrySeason1[1]);//
  var finish3=ee.Date.fromYMD(year3,DrySeason1[2],DrySeason1[3]);
  var start4=ee.Date.fromYMD(year3,DrySeason2[0],DrySeason2[1]);//
  var finish4=ee.Date.fromYMD(year3,DrySeason2[2],DrySeason2[3]);
  
  var collection1 = ee.ImageCollection(collection)
    .filterBounds(point)
    .filterDate(start1, finish1)
    .sort('CLOUD_COVER', true)
    .map(applyScaleFactors);  
  var collection2 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
    .filterBounds(point)
    .filterDate(start2, finish2)
    .sort('CLOUD_COVER', true)
    .map(applyScaleFactors); 
  var collection3 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
    .filterBounds(point)
    .filterDate(start3, finish3)
    .sort('CLOUD_COVER', true)
    .map(applyScaleFactors);  
  var collection4 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
    .filterBounds(point)
    .filterDate(start4, finish4)
    .sort('CLOUD_COVER', true)
    .map(applyScaleFactors); 
  // megreg the collections: 
  var Merged=collection1  
    .merge(collection2)
    .merge(collection3)
    .merge(collection4);
    
  return Merged;
}

// cloud mask representing just QA_cloud positve pixels
function getCloudMask (image) {
  var qa = image.select('QA_PIXEL');
  // Landsat 7: bit 3 indicates cloud
  var cloudBitMask = 1 << 3; // << create binary mask binarymask = 1000 
  // Binary cloud mask: 1 for cloud, 0 for clear.
    var cloudMask = qa.bitwiseAnd(cloudBitMask).neq(0);// compare clodBitMask bit to the pixel QA vit value
  return cloudMask; 
} 

function getClouds2(image) {
  var qa = image.select('QA_PIXEL');
  
  var qaMask = qa.bitwiseAnd(parseInt('11111', 2)).eq(0);
  var saturationClear = image.select('QA_RADSAT').eq(0);
  var cloudFlag = qa.bitwiseAnd(1 << 3).neq(0);
  
  var cloudConfidence = qa.rightShift(8).bitwiseAnd(3).gte(2); 
  var shadowConfidence = qa.rightShift(10).bitwiseAnd(3).gte(2);
  
  var problematic = cloudFlag.or(cloudConfidence).or(shadowConfidence);
  var clearMask = qaMask.and(saturationClear).and(problematic.not());
  // adds a buffer 
  var buffer = 5;
  var dilatedMask = clearMask.focal_min({
    radius: buffer, 
    kernel: ee.Kernel.square(buffer), 
    iterations: 1
  });
  
  return image.updateMask(dilatedMask);
}

function getCloudFraction(image){
  
  var cloudMask= getCloudMask(image); // call CloudMask function 
  
  // Compute the number of CLOUD pixels in the geometry -> dict 
  var cloudStats = cloudMask.reduceRegion({ 
    reducer: ee.Reducer.sum(), // sum the values of the cloudMask layer 
    geometry: Taita_AOI, // area of interest params 
    scale: 30, // resolution 
    maxPixels: 1e9 // limit 
  });
  
  // A total amount of pixels in the cliped image 
  var totalStats = image.select(0).reduceRegion({
    reducer: ee.Reducer.count(),
    geometry: Taita_AOI,
    scale: 30,
    maxPixels: 1e9
  });
  
  //_____________cloud fraction___________________ 
  var cloudPixels = ee.Number(cloudStats.get(cloudMask.bandNames().get(0))); // get the sum oc Cloud pixels from the cloudStats dict
  var totalPixels = ee.Number(totalStats.get(image.select(0).bandNames().get(0))); // sum of all pixies 
  
  // Cloaud fraction calculation 
  var cloudFraction = ee.Algorithms.If(totalPixels.gt(0), // dont devide by 0 
                                       cloudPixels.divide(totalPixels), // 
                                       0);
  
  // Set the computed cloud fraction as a property on the image
  return image.set('cloud_fraction', cloudFraction);
}

function getNDVI(image) {
  var ndvi = image.normalizedDifference(['SR_B4', 'SR_B3']).rename('NDVI');
  return image.addBands(ndvi);
}

