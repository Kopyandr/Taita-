  'LANDSAT_7': bands_L7,
  'LANDSAT_8': bands_L8
});

// function, returns a a classified image dictionary + meanNDVI for sorting mosaics 
function classification(img) {
  img = ee.Image(img);
  var year     = ee.Number(img.get('year'));
  var yearKey  = year.format('%d');
  var imageType= ee.String(img.get('image_type')); 
  var sensor   = ee.String(img.get('SPACECRAFT_ID'));
  var data     = ee.FeatureCollection(yearTableDict.get(yearKey));

  var bands = ee.List(
    ee.Algorithms.If(sensor.equals('LANDSAT_2'), bands_L2,
    ee.Algorithms.If(sensor.equals('LANDSAT_5'), bands_L5,
    ee.Algorithms.If(sensor.equals('LANDSAT_7'), bands_L7,
    ee.Algorithms.If(sensor.equals('LANDSAT_8'), bands_L8,
                     bands_L5 ))))
  );

  // Sample, train, classify…
  var Points    = data.map(reclass);
  var samples   = img.select(bands).sampleRegions({
    collection: Points,
    properties: ['class6'],
    scale: 60,
    geometries: true
  });
  var withRand  = samples.randomColumn('rand', 42);
  var trainSet  = withRand.filter(ee.Filter.lt('rand', 0.7)); // 70% train set   
  var classifier= ee.Classifier.smileRandomForest(50)
                         .train({
                            features:   trainSet,
                            classProperty: 'class6',
                            inputProperties: bands
                          });
  var classified = img.select(bands).classify(classifier);

  // Compute mean NDVI for metadata
  var meanNDVI = img.select('NDVI')
                    .reduceRegion({
                      reducer: ee.Reducer.mean(),
                      geometry: Taita_AOI,
                      scale: 30,
                      maxPixels: 1e9
                    })
                    .get('NDVI');

  // *** SIMPLIFIED RETURN: just the classified image with properties ***
  return classified.set({
    'year':      year,
    'meanNDVI':  meanNDVI,
    'image_type': imageType
  });
}


