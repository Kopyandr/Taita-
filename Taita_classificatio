// Function to calculate land cover area (%) for a classified image
function getClassArea(image) {
  var year = ee.Number(image.get('year'));
  var areaImage = ee.Image.pixelArea().divide(1e6); // km2

  var classStats = areaImage.addBands(image).reduceRegion({
    reducer: ee.Reducer.sum().group({
      groupField: 1, // band index for classes
      groupName: 'class'
    }),
    geometry: Taita,
    scale: 30,
    maxPixels: 1e13
  });

  var groups = ee.List(classStats.get('groups'));
  var totalArea = groups.map(function(g) {
    return ee.Dictionary(g).get('sum');
  }).reduce(ee.Reducer.sum());

  var feats = groups.map(function(g) {
    g = ee.Dictionary(g);
    var cls = g.get('class');
    var area = ee.Number(g.get('sum'));
    var pct = area.divide(totalArea).multiply(100);
    
    var clsName = nameMap.get(cls);

    
    return ee.Feature(null, {
      'year': year.format(),
      'class': clsName,
      'area_km2': area,
      'percent': pct
    });
  });

  return ee.FeatureCollection(feats);
}
