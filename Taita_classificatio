//____________________________________________________________________________________________________________________
//                                        Image collection - LS2 Calibration ATM corection  
//                              imports selected GLS 1975 Landsat images (MSS) and TOA products 
//                      calibrate DN values to TOA: https://yceo.yale.edu/how-convert-landsat-dns-top-atmosphere-toa-reflectance
//                          than TOA -> SR by"Normalised Dark Object Reflectance Substraction" 
//______________________________________________________________________________________________________________________
//                                        Import LS2 MSS images 
//                                      DN to TOA trasnformation + ATM 
//______________________________________________________________________________________________________________________
var raw = ee.Image('LANDSAT/GLS1975/p179r063_2x19750727');
print(raw)
// 1) Select the actual numeric bands [10,20,30,40]
var mss = raw.select(['10','20','30','40']);

// 2) DN → at-sensor radiance: L = gain·DN + bias
var radiance = mss
  .multiply(ee.Image.constant([
    raw.getNumber('GAIN_BAND1'),
    raw.getNumber('GAIN_BAND2'),
    raw.getNumber('GAIN_BAND3'),
    raw.getNumber('GAIN_BAND4')
  ]))
  .add(ee.Image.constant([
    raw.getNumber('BIAS_BAND1'),
    raw.getNumber('BIAS_BAND2'),
    raw.getNumber('BIAS_BAND3'),
    raw.getNumber('BIAS_BAND4')
  ]));

// 3) Earth–sun distance (AU) from acquisition date
var date = ee.Date(raw.get('system:time_start'));
var doy  = date.getRelative('day', 'year').add(1);
var d = ee.Number(1)
  .subtract(
    ee.Number(0.01672)
      .multiply(
        doy.subtract(4)
           .multiply(2 * Math.PI / 365)
           .cos()
      )
  );

// Sun elevation → radians, then compute cos(zenith)
var sunElRad = ee.Number(raw.get('SUN_ELEVATION')).multiply(Math.PI/180);
var cosZenith = sunElRad.cos();

// Exo-atmospheric solar irradiance for MSS [band10,20,30,40]
//    
var ESUN = ee.Image.constant([1848, 1588, 1235, 856.6]);// USGS Level 1 product 

// Radiance -> TOA reflectance: ρ = π*L*d² ÷ (ESUN*cosθₛ) <- missing the reflectance multibandfor USGS procedure 
var toa = radiance
  .multiply(ee.Image.constant(Math.PI).multiply(ee.Image.constant(d.pow(2))))
  .divide(ESUN.multiply(ee.Image.constant(cosZenith)));

