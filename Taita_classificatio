//                                  Classification accuracy function
//                                  acces the accuracy of the mosaic
//____________________________________________________________________________________________________________________

function accuracy(img) {
  img = ee.Image(img);

  // Get the right year’s training table & relabel
  var yearKey = ee.Number(img.get('year')).format('%d');
  var tableFC = ee.FeatureCollection(yearTableDict.get(yearKey))
                   .map(reclass);

  //  Recreate 70/30 split with seed = 42
  var testFC = tableFC
    .randomColumn('rand', 42)
    .filter(ee.Filter.gte('rand', 0.7));

  // 
  var samples = img.sampleRegions({
    collection: testFC,
    properties: ['class6'],
    scale: 60,
    geometries: true
  });

  // 
  var cm  = samples.errorMatrix('class6', 'classification');
  var acc = cm.accuracy();

  var cmList = cm.array().toList();
  //  print the matrix
  //print('Confusion Matrix ' + yearKey, cm);

  // Return the image with an 'accuracy' property
  return img.set({
    'accuracy':        acc,
    'confusion_matrix': cmList
  });
}


