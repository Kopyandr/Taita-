// get statistics for the LST time series(min and max)
var LSTcollection= ee.ImageCollection.fromImages([LST,LST1, LST2, LST3,LST4,LST5,LST6]);
var lstMinImage = LSTcollection.min();
var lstMaxImage = LSTcollection.max();
// minimum 
var overallMin = lstMinImage.reduceRegion({
  reducer: ee.Reducer.min(), 
  geometry: Taita_AOI,
  scale: 30,
  bestEffort: true,
  maxPixels: 1e9
});
// maximum 
var overallMax = lstMaxImage.reduceRegion({
  reducer: ee.Reducer.max(), 
  geometry: Taita_AOI,
  scale: 30,
  bestEffort: true,
  maxPixels: 1e9
});

print('Overall minimum LST (°C):', overallMin);
print('Overall maximum LST (°C):', overallMax);



