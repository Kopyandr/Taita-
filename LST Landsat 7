// Loop through each collection
years.forEach(function(year, index) {
  var col = ee.ImageCollection(collections[index]).select('ST_B6');
  
  // Compute pixelwise min and max for each year's collection
  var minImage = col.min();
  var maxImage = col.max();
  
  // Reduce over your region to get scalar values
  var statsMin = minImage.reduceRegion({
    reducer: ee.Reducer.min(),
    geometry: Taita_AOI,
    scale: 60,
    bestEffort: true,
    maxPixels: 1e9
  });
  
  var statsMax = maxImage.reduceRegion({
    reducer: ee.Reducer.max(),
    geometry: Taita_AOI,
    scale: 60,
    bestEffort: true,
    maxPixels: 1e9
  });
  
  // Optionally convert from Kelvin to Celsius
  var minC = ee.Number(statsMin.get('ST_B6')).subtract(273.15);
  var maxC = ee.Number(statsMax.get('ST_B6')).subtract(273.15);
  
  print('Year ' + year + ' LST stats ():', statsMin, statsMax);
  print('Year ' + year + ' LST stats (°C):', minC, maxC);
});    


