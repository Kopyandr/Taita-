 # delete existing file/folder
def delete_path_if_exists(path):
    if os.path.exists(path):
        if os.path.isfile(path) or os.path.islink(path):
            os.remove(path)
        else:
            shutil.rmtree(path)

# BUILD 2023 REFERENCE STATS
