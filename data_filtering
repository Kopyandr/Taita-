#FILTER OTHER YEARS
os.makedirs(output_dir, exist_ok=True) #make sure the path exist 

for d in input_dirs: 
    for fn in glob.glob(os.path.join(d, "samples_*.csv")): # find and open files with .glob 
        # skip the reference files of 2023 or what ever year 
        if fn.endswith(f"_{date_ref}.csv"):
            continue

        df = pd.read_csv(fn)  # load the file as df
        stored_columns = {}  # dictionary to store dropped columns

        for drop_col in ['system:index', '.geo', 'THERMAL']:  # specify columns to store
            if drop_col in df.columns:
                stored_columns[drop_col] = df[drop_col]  # store the column
                df.drop(drop_col, axis=1, inplace=True)  # drop the column from the main DataFrame

        # extract year  class from filename, e.g. samples_L7_2000.csv → year=2000
        basename = os.path.basename(fn)
        year = basename.rsplit("_", 1)[-1].replace(".csv", "")
        prefix = basename.replace("samples_", "").replace(".csv", "")
        
        #Add indicies         
        #df['SIPI'] = (df[nir] - df[blue]) / (df[nir] - df[red])

        
        if year == '2015': # Landsat 8 data  
            df['TCG']=0.1509 * df['BLUE'] + 0.1973 * df['GREEN'] + 0.3279 * df['RED'] + 0.3406 * df['NIR'] - 0.7112 * df['SWIR1'] - 0.4572 * df['SWIR2'] #Tasseld Cap greenes 
            df['TCW']= 0.1511*df['BLUE'] + 0.1973*df['GREEN'] + 0.3283*df['RED'] + 0.3407*df['NIR'] - 0.7117*df['SWIR1'] - 0.4559*df['SWIR2'] # tasseld wetnesss 
            df['SIPI'] = (df[nir] - df[blue]) / (df[nir] - df[red])
        elif year== '1975': 
             print('no cap for MSS')
             
        else:  #LS 5 to  LS 7 
           df['TCG']=  -0.2848 * df['BLUE'] - 0.2435 * df['GREEN'] - 0.5436 * df['RED'] + 0.7243 * df['NIR'] + 0.0840 * df['SWIR1'] - 0.1800 * df['SWIR2'] #TC greenes 
           df['TCW']=   0.1509 * df['BLUE'] + 0.1973 * df['GREEN'] + 0.3279 * df['RED'] + 0.3406 * df['NIR'] - 0.7112 * df['SWIR1'] - 0.4572 * df['SWIR2'] #wetness
           df['SIPI'] = (df[nir] - df[blue]) / (df[nir] - df[red])
           
        stats_years[year] = {}
        for cls, subset in df.groupby(class_col): 
            stats_years[year][cls] = {
                'mean_ndvi':  subset[ndvi_col].mean(),
                'std_ndvi':   subset[ndvi_col].std(),
                'mean_sipi':  subset['SIPI'].mean(),
                'std_sipi':   subset['SIPI'].std(),
                'mean_swir1': subset['SWIR1'].mean(),
                'std_swir1':  subset['SWIR1'].std(),
                'var_ndvi':subset['NDVI'].var(),
                'var_sipi':subset['SIPI'].var(),
                'var_swir1':subset['SWIR1'].var(),
                'IQR_ndvi':(np.quantile(subset['NDVI'],0.05))-(np.quantile(subset['NDVI'],0.95)),
                'IQR_sipi': (np.quantile(subset['SIPI'],0.05))-(np.quantile(subset['SIPI'],0.95)),
                'IQR_swir1':(np.quantile(subset['SWIR1'],0.05))-(np.quantile(subset['SWIR1'],0.95)),     
            }
            
             
        
        # 0.1509 * blue + 0.1973 * green + 0.3279 * red + 0.3406 * nir - 0.7112 * swir1 - 0.4572 * swir2
        
        # filter each class
        # Filter each class
for cls, cls_ref in stats_ref.items():  # class + {mean, std, IQR}
    cls_df = df[df[class_col] == int(cls)]  # Filter rows for the current class
    if cls_df.empty:
        continue

    # Grab IQR thresholds for the reference year
    ref_iqr_ndvi = stats_ref[cls]['IQR_ndvi']
    ref_iqr_sipi = stats_ref[cls]['IQR_sipi']
    ref_iqr_swir1 = stats_ref[cls]['IQR_swir1']

    # Calculate IQR-based thresholds for the current year
    year_mean_ndvi = stats_years[year][cls]['mean_ndvi']
    year_mean_sipi = stats_years[year][cls]['mean_sipi']
    year_mean_swir1 = stats_years[year][cls]['mean_swir1']

    lower_q25_ndvi = year_mean_ndvi - ref_iqr_ndvi
    upper_q75_ndvi = year_mean_ndvi + ref_iqr_ndvi
    lower_q25_sipi = year_mean_sipi - ref_iqr_sipi
    upper_q75_sipi = year_mean_sipi + ref_iqr_sipi
    lower_q25_swir1 = year_mean_swir1 - ref_iqr_swir1
    upper_q75_swir1 = year_mean_swir1 + ref_iqr_swir1

    # Create masks for rows outside the IQR range
    mask_out_ndvi = ~cls_df[ndvi_col].between(lower_q25_ndvi, upper_q75_ndvi)
    mask_out_sipi = ~cls_df['SIPI'].between(lower_q25_sipi, upper_q75_sipi)
    mask_out_swir1 = ~cls_df['SWIR1'].between(lower_q25_swir1, upper_q75_swir1)

    # Combine masks: delete rows that fall outside any of the IQR ranges
    mask_delete = mask_out_ndvi | mask_out_sipi | mask_out_swir1

    # Debugging: Print how many rows are being filtered
    print(f"Class {cls}: Filtering {mask_delete.sum()} rows out of {len(cls_df)}")

    # Keep rows that are within the IQR range
    kept = cls_df[~mask_delete]
    kept_all.append(kept)

# Combine all kept rows for the year
if kept_all:
    df_year = pd.concat(kept_all, ignore_index=True)

    # Drop all columns that are not needed
    columns_to_keep = ['system:index', 'class6', '.geo']  # Adjust as needed
    df_year = df_year[[col for col in df_year.columns if col in columns_to_keep]]

    # Reattach stored columns
    for col_name, col_data in stored_columns.items():
        df_year[col_name] = col_data[:len(df_year)]  # Reattach stored columns to the filtered DataFrame

    # Save the filtered data
    year_out = os.path.join(output_dir, f"{year}_filtered.csv")
    delete_path_if_exists(year_out)
    df_year.to_csv(year_out, index=False)
    print(f"Saved {len(df_year)} total rows for year {year} into {year}_filtered.csv")
