    for fn in glob.glob(pattern): # open all files in the file with glob 
        df_ref_list.append(pd.read_csv(fn)) # read the CVS to pandas dataframe 

if not df_ref_list: # if df empty, rise an issue 
    raise ValueError(f"No 2023 CSVs found! Looking for {pattern}")

