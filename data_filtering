    cls_name = cls_dict.get(str(cls), f"Class{cls}") #maps over names for printing 
    print(f"  {cls_name:<12} (code {cls}): std NDVI = {vals['std_ndvi']:.4f}") 
    

#PER YEAR PER CLASS STATS
