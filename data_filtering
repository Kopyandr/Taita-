# Tasseled cap transformation for LS8 
df_ref['SIPI'] = (df_ref[nir] - df_ref[blue]) / (df_ref[nir] - df_ref[red]) #calc SIPI for the current year # tasseld cap   
df_ref['TCG']=0.1509 * df_ref['BLUE'] + 0.1973 * df_ref['GREEN'] + 0.3279 * df_ref['RED'] + 0.3406 * df_ref['NIR'] - 0.7112 * df_ref['SWIR1'] - 0.4572 * df_ref['SWIR2'] #Tasseld Cap greenes 
df_ref['TCW']= 0.1511*df_ref['BLUE'] + 0.1973*df_ref['GREEN'] + 0.3283*df_ref['RED'] + 0.3407*df_ref['NIR'] - 0.7117*df_ref['SWIR1'] - 0.4559*df_ref['SWIR2'] # tasseld wetnesss 

# compute mean & std per class
stats_ref = {} #dict of stats 
# cls -> current class code 
for cls, subset in df_ref.groupby(class_col): # create datafreames with the same class (class_col=class6)
    mean_ndvi = subset[ndvi_col].mean() # calculate meand of NDVI 
    std_ndvi  = subset[ndvi_col].std() # standard deviation 
    mean_sipi=subset['SIPI'].mean()
    std_sipi=subset['SIPI'].std()
    mean_swir1=subset['SWIR1'].mean()
    std_swir1=subset['SWIR1'].std()
    
    #calculate variance
    var_ndvi=subset['NDVI'].var()
    var_sipi=subset['SIPI'].var()
    var_swir1=subset['SWIR1'].var()
    
    #  interquartile range 
    q25_ndvi=np.quantile(subset['NDVI'],0.05)
    q75_ndvi=np.quantile(subset['NDVI'], 0.95)
    q25_sipi=np.quantile(subset['SIPI'],0.05)
    q75_sipi=np.quantile(subset['SIPI'],0.95)
    q25_swir1=np.quantile(subset['SWIR1'],0.05)
    q75_swir1=np.quantile(subset['SWIR1'], 0.95)
    
    #inter quartile range
    IQR_ndvi= q75_ndvi - q25_ndvi
    IQR_sipi= q75_sipi-q25_sipi
    IQR_swir1= q75_swir1-q25_swir1
    
    stats_ref[cls] = {'mean_ndvi': mean_ndvi, 'std_ndvi': std_ndvi,
                      'mean_sipi':mean_sipi,'std_sipi':std_sipi,
                      'mean_swir1':mean_swir1, 'std_swir1':std_swir1,
                      'var_ndvi':var_ndvi, 'var_sipi':var_sipi, 'var_swir1':var_swir1,
                      'IQR_ndvi':IQR_ndvi,'IQR_sipi':IQR_sipi,'IQR_swir1':IQR_swir1}
    
     
     
    # giives df_ref={1: {'mean': 0.5451, 'std': 0.1234},
    # }
    
